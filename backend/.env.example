# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Food Bundles Chef API"
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://foodbundles:password@localhost:5432/foodbundles_chef
DATABASE_URL_SYNC=postgresql+psycopg://foodbundles:password@localhost:5432/foodbundles_chef

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","exp://localhost:8081"]

# ── OTP ───────────────────────────────────────────────────────────────────────
# Providers: mock | sms_provider_name
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Only for mock provider — never set in production
MOCK_OTP_CODE=

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=FoodBundles

# ── Meta Model API ────────────────────────────────────────────────────────────
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY="LLM_2048438262507749_ao7xba0JwapOkEeqh6a6nT_yWiE"

# Hosted model IDs — verify against official docs before setting
META_MUSE_SPARK_MODEL=
META_MUSE_WONDER_MODEL=
META_MUSE_IMAGE_MODEL=
META_MUSE_VOICE_MODEL=
META_SAM_MODEL=

# Open-weight self-hosted endpoints
MUSE_GLIMMER_BASE_URL=
MUSE_GLIMMER_MODEL=

MUSE_SPARK_OPEN_BASE_URL=
MUSE_SPARK_OPEN_MODEL=

# AI feature controls
AI_ENABLED=false
AI_DEFAULT_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_IMAGE_SIZE_BYTES=1048576
AI_LOG_CONTENT=false

# ── Food Bundles catalog integration ──────────────────────────────────────────
# Provider: mock | live
FOOD_BUNDLES_CATALOG_PROVIDER=mock
FOOD_BUNDLES_API_URL=
FOOD_BUNDLES_API_KEY=

# ── Object storage ────────────────────────────────────────────────────────────
# Provider: local | s3 | gcs
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=food-bundles-chef
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT_URL=
LOCAL_STORAGE_PATH=./storage

# ── Push notifications ────────────────────────────────────────────────────────
# Provider: mock | expo
PUSH_NOTIFICATIONS_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# ── Docker compose overrides (optional) ───────────────────────────────────────
# These are used by docker-compose.yml variable substitution.
# Set in your shell or a .env file; defaults are shown below.
# DB_USER=foodbundles
# DB_PASSWORD=change-me-in-production
# DB_NAME=foodbundles_chef
# DB_EXTERNAL_PORT=5432
# REDIS_EXTERNAL_PORT=6379
# API_PORT=8000
