# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Food Bundles Chef API"
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://foodbundles:password@localhost:5432/foodbundles_chef
DATABASE_URL_SYNC=postgresql+psycopg://foodbundles:password@localhost:5432/foodbundles_chef

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","exp://localhost:8081"]

# ── OTP ───────────────────────────────────────────────────────────────────────
# Providers: mock | sms_provider_name
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Only for mock provider — never set in production
MOCK_OTP_CODE=

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=FoodBundles

# ── Meta Model API ────────────────────────────────────────────────────────────
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
# Secret — set it in your local .env or the deployment secret store, never in this file.
MODEL_API_KEY=

# Hosted model IDs — verify against official docs before setting
META_MUSE_SPARK_MODEL=
META_MUSE_WONDER_MODEL=
META_MUSE_IMAGE_MODEL=
META_MUSE_VOICE_MODEL=
META_SAM_MODEL=

# Open-weight self-hosted endpoints
MUSE_GLIMMER_BASE_URL=
MUSE_GLIMMER_MODEL=

MUSE_SPARK_OPEN_BASE_URL=
MUSE_SPARK_OPEN_MODEL=

# AI feature controls — everything is off by default. A capability needs AI_ENABLED=true
# AND its own flag; turning a flag off (and restarting) is the kill switch. The app reads
# GET /kitchens/{id}/ai/features and falls back to manual entry.
AI_ENABLED=false
AI_AGENT_ENABLED=false
AI_DEFAULT_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_IMAGE_SIZE_BYTES=1048576
AI_LOG_CONTENT=false
AI_QUALITY_ASSESSMENT_ENABLED=false
AI_IMAGE_CLASSIFY_ENABLED=false
AI_MENU_SCAN_ENABLED=false
AI_DISH_ANALYSIS_ENABLED=false
AI_DOCUMENT_SCAN_ENABLED=false
AI_TRANSCRIPTION_ENABLED=false
# Comma-separated languages whose speech-to-text passed evaluation (ai-evals), e.g. "en,fr".
# Leave rw out until a provider is evaluated for Kinyarwanda — audio is never sent otherwise.
AI_TRANSCRIPTION_LANGUAGES=
# Assistant total budget in seconds until chat streaming (Phase 8 step 1b) uses AI_TIMEOUT_CHAT_TTFT_MS
AI_CHAT_TIMEOUT_SECONDS=30
# Cheaper model for image classification; empty = use META_MUSE_SPARK_MODEL
META_MUSE_SPARK_FAST_MODEL=
# Dish price suggestion: target food-cost share of the selling price (25–35%)
AI_TARGET_FOOD_COST_LOW=0.25
AI_TARGET_FOOD_COST_HIGH=0.35
# Daily AI request budgets (0 = no limit). Both apply.
AI_MAX_REQUESTS_PER_KITCHEN_PER_DAY=0
AI_MAX_REQUESTS_PER_CHEF_PER_DAY=0

# ── AI providers (Phase 8): Anthropic primary, Meta fallback ──────────────────
# See docs/ai-providers.md. Keys live only in server env / a secret manager.
# Speech-to-text always stays on Meta (Anthropic has no STT).
AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=meta
# Leave empty to run on Meta only (identical to pre-Phase-8 behaviour).
ANTHROPIC_API_KEY=
# false = skip Anthropic (needs a restart). For an instant switch without a
# restart use PUT /api/v1/ai/kill-switch/anthropic (ops token).
ANTHROPIC_ENABLED=true
# Model IDs — verified against the Claude model list on 2026-11-18.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
ANTHROPIC_MODEL_ADVANCED=claude-opus-5-5
# Effort per task (low|medium|high); extraction/chat are tuned from Step 2 evals.
ANTHROPIC_EFFORT_CLASSIFY=low
ANTHROPIC_EFFORT_EXTRACT=low
ANTHROPIC_EFFORT_CHAT=low
# Optional JSON overrides; defaults are in app/core/config.py
# AI_MODEL_CAPABILITIES={"claude-sonnet-5-5": {"supports_temperature": false, "supports_effort": true}}
# AI_MODEL_PRICES={"muse-spark-1.3": {"input": 1.25, "output": 4.25, "cache_read": 0.15, "cache_write": 1.25}}
# Total time budget per feature, fallback attempt INCLUDED
AI_TIMEOUT_CLASSIFY_MS=15000
AI_TIMEOUT_EXTRACT_MS=30000
AI_TIMEOUT_CHAT_TTFT_MS=8000
# Share of the budget the primary may use, so the fallback still has time
AI_PRIMARY_BUDGET_SHARE=0.6
# Router retries per provider (0-2) with backoff + jitter, honouring retry-after
AI_ROUTER_MAX_RETRIES=1
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=30000
# Daily cost caps in USD (0 = no cap); spend is stored in ai_spend_daily
AI_DAILY_BUDGET_USD=0
AI_KITCHEN_DAILY_BUDGET_USD=0
# What happens when a cap is reached: cheaper_tier | fallback | block
AI_BUDGET_EXCEEDED_ACTION=fallback
# Ops token for GET /api/v1/ai/health and the kill switch (empty = endpoints off)
AI_OPS_TOKEN=

# ── Food Bundles catalog integration ──────────────────────────────────────────
# Provider: mock | live
FOOD_BUNDLES_CATALOG_PROVIDER=mock
FOOD_BUNDLES_API_URL=
FOOD_BUNDLES_API_KEY=

# ── Exchange rates (server only; the app never sees these keys) ───────────────
# ExchangeRate-API paid plan = primary. Leave empty to use Frankfurter (free) alone.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
FRANKFURTER_API_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATE_TIMEOUT_SECONDS=20
# Days a rate stays usable (shown with its date); older or missing = "rate unavailable".
RATE_STALE_DAYS=3
# JSON list of ISO 3166-1 alpha-2 countries where currency conversion is offered (all in development)
CURRENCY_CONVERSION_ENABLED_COUNTRIES=["RW"]

# ── Object storage ────────────────────────────────────────────────────────────
# Provider: local | s3 | gcs
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=food-bundles-chef
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT_URL=
LOCAL_STORAGE_PATH=./storage

# ── Push notifications ────────────────────────────────────────────────────────
# Provider: mock | expo
PUSH_NOTIFICATIONS_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# ── Docker compose overrides (optional) ───────────────────────────────────────
# These are used by docker-compose.yml variable substitution.
# Set in your shell or a .env file; defaults are shown below.
# DB_USER=foodbundles
# DB_PASSWORD=change-me-in-production
# DB_NAME=foodbundles_chef
# DB_EXTERNAL_PORT=5432
# REDIS_EXTERNAL_PORT=6379
# API_PORT=8000
