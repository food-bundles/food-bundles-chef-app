{
  "expo": {
    "name": "FoodBundles Chef",
    "slug": "food-bundles-chef-app",
    "scheme": "foodbundleschef",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "rw.foodbundles.chef",
      "newArchEnabled": true
    },
    "android": {
      "package": "rw.foodbundles.chef",
      "newArchEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FoodBundles uses your location to help set your kitchen location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FoodBundles needs access to your photos to add menu items and check deliveries."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "FoodBundles needs microphone access for voice notes if needed."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "chef-app-placeholder"
      }
    }
  }
}
