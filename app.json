{
  "expo": {
    "name": "Food Bundles Chef",
    "slug": "food-bundles-chef-app",
    "version": "1.0.0",
    "scheme": "chef",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2027"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodbundles.chefapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2027"
      },
      "package": "com.foodbundles.chefapp"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Food Bundles Chef to access your camera to photograph deliveries."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1DB954"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
