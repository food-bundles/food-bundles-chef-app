# Eval runs: raw model responses, per-arm SQLite databases and reports stay local.
# Copy a report into docs/ when it should be kept.
results/*
inbox/*
!results/.gitkeep
__pycache__/
*.pyc

# Real eval photos and their answer keys stay local (privacy, licences): only the harness,
# the graders, the Assistant text cases and the folder skeleton are committed.
cases/menu/*
cases/dish/*
cases/document/*
cases/junk/*
!cases/*/.gitkeep
# Review sheet built from the real photos
review.html
review.csv
