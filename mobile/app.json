{
  "expo": {
    "name": "Food Bundles Chef",
    "slug": "food-bundles-chef-app",
    "version": "1.0.0",
    "scheme": "chef",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1DB954"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodbundles.chefapp"
    },
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1DB954"
      },
      "package": "com.foodbundles.chefapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Food Bundles Chef to access your camera to photograph deliveries."
        }
      ],
      "expo-splash-screen",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Food Bundles Chef to access your photos to set a kitchen photo.",
          "cameraPermission": "Allow Food Bundles Chef to take a kitchen photo."
        }
      ],
      "./plugins/withExpoModulesProguard",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Food Bundles Chef to access your location to tag delivery locations and track routes.",
          "locationWhenInUsePermission": "Allow Food Bundles Chef to access your location to tag delivery locations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1a55caec-1c71-4c8b-a86b-dee49eaa9828"
      },
      "apiBaseUrl": "http://72.60.18.7:8001/api/v1"
    },
    "owner": "umurava"
  }
}
