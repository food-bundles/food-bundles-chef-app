# Food Bundles Chef App — environment variables
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env — it is git-ignored.
# NEVER put real credentials here; this file is example/documentation only.

# Base URL of the Food Bundles Chef backend API.
# Local development (iOS Simulator / web): http://localhost:8000
# Local development (Android Emulator):    http://10.0.2.2:8000
# Staging:                                 https://api-staging.foodbundles.example
# Production:                              https://api.foodbundles.example
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
